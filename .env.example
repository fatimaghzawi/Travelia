# Example env file — copy into .env.local (never commit secrets)

NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/travelia
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
# AUTH_URL is optional when NEXT_PUBLIC_APP_URL is set; Auth.js also uses AUTH_URL
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email — development (Mailpit / local SMTP)
# EMAIL_PROVIDER=nodemailer
# EMAIL_FROM=Travelia <noreply@travelia.local>
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=

# Email — Elastic Email (HTTP API — recommended)
EMAIL_PROVIDER=elasticemail
# Must be a verified sender in Elastic Email → Settings → Domains / Single senders
EMAIL_FROM=Travelia <noreply@yourdomain.com>
# Optional: public logo URL (if unset, logo is embedded inline in HTML — no attachment)
# EMAIL_LOGO_URL=https://yourdomain.com/images/logo.png
ELASTIC_EMAIL_API_KEY=your-elastic-email-api-key
# Do NOT set ELASTIC_EMAIL_USE_SMTP unless you created separate SMTP credentials.
# API key alone uses the HTTP API (scripts/test-elastic-email.mjs to smoke-test).
# ELASTIC_EMAIL_USE_SMTP=true
# ELASTIC_EMAIL_USERNAME=your-account@yourdomain.com
# SMTP_HOST=smtp.elasticemail.com
# SMTP_PORT=465

# Email — production (Resend)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=Travelia <noreply@yourdomain.com>

# Stripe (Checkout + webhooks)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Local: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Vercel Blob (private store) — required for uploads on Vercel.
# After creating the store: vercel link && vercel env pull
# Or paste from the Vercel dashboard → Storage → your Blob store.
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Optional if your dashboard shows a store id env (OIDC / multi-store):
# BLOB_STORE_ID=store_...
# vercel_blob_rw_travelia_STORE_ID=store_...
